        </property>
        <property name="bottomMargin">
         <number>2</number>
        </property>
        <item>
         <widget class="QTableWidget" name="atcMessages">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>Controller-pilot data link (CPDLC) messages for the selected aircraft or flight</string>
          </property>
          <property name="editTriggers">
           <set>QAbstractItemView::NoEditTriggers</set>
          </property>
          <property name="selectionMode">
           <enum>QAbstractItemView::SingleSelection</enum>
          </property>
          <property name="selectionBehavior">
           <enum>QAbstractItemView::SelectRows</enum>
          </property>
          <column>
           <property name="text">
            <string>Time</string>
           </property>
           <property name="toolTip">
            <string>Time the message was received</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Protocol</string>
           </property>
           <property name="toolTip">
            <string>Message protocol, e.g. CPDLC</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Dir</string>
           </property>
           <property name="toolTip">
            <string>Message direction: up arrow for uplink (ATC to aircraft), down arrow for downlink</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>From</string>
           </property>
           <property name="toolTip">
            <string>Message source, when known</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>To</string>
           </property>
           <property name="toolTip">
            <string>Message recipient, when known</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Message</string>
           </property>
           <property name="toolTip">
            <string>The ATC message text</string>
           </property>
          </column>
         </widget>
        </item>
       </layout>
      </widget>
