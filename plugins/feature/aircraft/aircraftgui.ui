           <bool>true</bool>
          </property>
         </widget>
         </widget>
        </item>
       </layout>
      </widget>
     <widget class="QWidget" name="logonsTab">
       <attribute name="title">
        <string>Logons</string>
       </attribute>
       <layout class="QVBoxLayout" name="logonsTabLayout">
        <property name="spacing">
         <number>2</number>
        </property>
        <property name="leftMargin">
         <number>2</number>
        </property>
        <property name="topMargin">
         <number>2</number>
        </property>
        <property name="rightMargin">
         <number>2</number>
        </property>
        <property name="bottomMargin">
         <number>2</number>
        </property>
        <item>
         <widget class="QSplitter" name="logonsSplitter">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
          <property name="childrenCollapsible">
           <bool>false</bool>
          </property>
          <widget class="QTableWidget" name="logons">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="toolTip">
           <string>Datalink logons for the selected aircraft or flight. Kept apart from the documents because there are far more of them than of everything else together.</string>
          </property>
          <property name="editTriggers">
           <set>QAbstractItemView::NoEditTriggers</set>
          </property>
          <property name="selectionMode">
           <enum>QAbstractItemView::SingleSelection</enum>
          </property>
          <property name="selectionBehavior">
           <enum>QAbstractItemView::SelectRows</enum>
          </property>
          <column>
           <property name="text">
            <string>Time</string>
           </property>
           <property name="toolTip">
            <string>Time the logon was received</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Callsign</string>
           </property>
           <property name="toolTip">
            <string>Callsign of the flight the logon belongs to</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Reg</string>
           </property>
           <property name="toolTip">
            <string>Aircraft registration or ICAO address</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Type</string>
           </property>
           <property name="toolTip">
            <string>Kind of logon</string>
           </property>
          </column>
          <column>
           <property name="text">
            <string>Title</string>
           </property>
           <property name="toolTip">
            <string>Logon title</string>
           </property>
          </column>
         </widget>
          <widget class="AcarsMessageView" name="logonText">
          <property name="toolTip">
           <string>The selected logon</string>
          </property>
          <property name="readOnly">
           <bool>true</bool>
          </property>
         </widget>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="atcTab">
       <attribute name="title">
        <string>ATC</string>
       </attribute>
       <layout class="QVBoxLayout" name="atcTabLayout">
        <property name="spacing">
         <number>2</number>
        </property>
        <property name="leftMargin">
