        <widget class="QWidget" name="msfsTab">
         <attribute name="title">
          <string>MSFS</string>
         </attribute>
         <layout class="QVBoxLayout" name="verticalLayout_5">
          <item>
           <widget class="QLabel" name="msfsDescription">
            <property name="text">
             <string>Use Microsoft Flight Simulator waypoint data and convert aircraft models.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QGridLayout" name="msfsDirectoryLayout">
            <item row="0" column="0">
             <widget class="QLabel" name="msfsNavigraphDirectoryLabel">
              <property name="text">
               <string>Waypoint BGL directory</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="msfsNavigraphDirectory">
              <property name="toolTip">
               <string>Directory recursively scanned for waypoint BGL files. Leave empty to use waypoints.csv.</string>
              </property>
             </widget>
            </item>
            <item row="0" column="2">
             <widget class="QPushButton" name="msfsNavigraphBrowse">
              <property name="text">
               <string>Browse…</string>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="msfsAircraftDirectoryLabel">
              <property name="toolTip">
               <string/>
              </property>
              <property name="text">
               <string>Aircraft model directory</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QLineEdit" name="msfsAircraftDirectory">
              <property name="toolTip">
               <string>Parent directory recursively scanned for aircraft.cfg files</string>
              </property>
             </widget>
            </item>
            <item row="1" column="2">
             <widget class="QPushButton" name="msfsBrowse">
              <property name="text">
               <string>Browse…</string>
              </property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="msfsOutputDirectoryLabel">
              <property name="text">
               <string>Converted models</string>
              </property>
             </widget>
            </item>
            <item row="2" column="1" colspan="2">
             <widget class="QLabel" name="msfsOutputDirectory">
              <property name="text">
               <string/>
              </property>
              <property name="textInteractionFlags">
               <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
              </property>
             </widget>
            </item>
            <item row="3" column="0">
             <widget class="QLabel" name="msfsMaxTextureSizeLabel">
              <property name="text">
               <string>Maximum texture size</string>
              </property>
             </widget>
            </item>
            <item row="3" column="1">
             <widget class="QComboBox" name="msfsMaxTextureSize">
              <property name="toolTip">
               <string>Largest livery texture written by the converter. A 4096 texture costs around 21MB of graphics memory however far away the aircraft is drawn, so this is the main control over how much memory a sky full of aircraft uses. 2048 is indistinguishable from 4096 except when very close; 1024 softens small markings. Takes effect on the next conversion.</string>
              </property>
              <item>
               <property name="text">
                <string>1024</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>2048</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>4096</string>
               </property>
              </item>
             </widget>
            </item>
            <item row="4" column="0">
             <widget class="QLabel" name="msfsLowDetailMaxTextureSizeLabel">
              <property name="text">
               <string>Maximum texture size (low detail)</string>
              </property>
             </widget>
            </item>
            <item row="4" column="1">
             <widget class="QComboBox" name="msfsLowDetailMaxTextureSize">
              <property name="toolTip">
               <string>Largest livery texture written for the low detail models. These are only drawn while an aircraft is small on screen - around 33 to 49 pixels across - so 512 is indistinguishable from 2048 there and uses a sixteenth of the graphics memory. Never larger than the setting above. Takes effect on the next conversion.</string>
              </property>
              <item>
               <property name="text">
                <string>256</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>512</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>1024</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>2048</string>
               </property>
              </item>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_3">
            <item>
             <widget class="QPushButton" name="convertMSFS">
              <property name="toolTip">
               <string>Convert every aircraft.cfg below the selected directory</string>
              </property>
              <property name="text">
               <string>Convert Aircraft Models</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="cancelMSFS">
              <property name="text">
               <string>Cancel</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="msfsButtonSpacer">
              <property name="orientation">
               <enum>Qt::Orientation::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QProgressBar" name="msfsProgress">
            <property name="maximum">
             <number>1</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPlainTextEdit" name="msfsLog">
            <property name="readOnly">
             <bool>true</bool>
            </property>
            <property name="placeholderText">
             <string>Conversion progress and errors will appear here.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
