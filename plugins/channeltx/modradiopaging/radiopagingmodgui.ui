     <widget class="QDateTimeEdit" name="flexTimeSet">
      <property name="toolTip">
       <string>Local date and time to send now (when Clock is unchecked); it runs on from the moment it is set</string>
      </property>
      <property name="displayFormat">
       <string>yyyy-MM-dd HH:mm</string>
      </property>
     </widget>
    </item>
    <item row="11" column="0" colspan="2">
     <widget class="QCheckBox" name="flexTimeEquivalentYear">
      <property name="toolTip">
       <string>Retro year: a year after 2025 (the year field counts 1994-2025) is sent as the latest year of that period&#10;with the same calendar (leap year and weekday of January 1), so a pager shows the right weekday&#10;and day of the year. Unchecked: the year modulo 32</string>
      </property>
      <property name="text">
       <string>Retro year</string>
      </property>
     </widget>
    </item>
    <item row="11" column="2" colspan="2">
     <widget class="QSpinBox" name="flexTimeExtendedSeconds">
      <property name="toolTip">
       <string>Extra seconds: the extended second S5-S3 of the time zone word (STD-43A 3.7.2), 0 to 7 steps of 1/64 minute&#10;(0.9375 s) added to the 7.5 s steps of the time word.&#10;Corrects the time a pager shows when the frames are not aligned to the second. Sent with the zone word</string>
      </property>
      <property name="prefix">
       <string>+</string>
      </property>
      <property name="suffix">
       <string> x 0.9375 s</string>
      </property>
      <property name="maximum">
       <number>7</number>
      </property>
     </widget>
    </item>
    <item row="12" column="0" colspan="2">
     <widget class="QCheckBox" name="flexNumbering">
      <property name="toolTip">
       <string>FLEX message numbering of the network (STD-43A 8.4, optional): the alphanumeric, HEX/binary and numbered&#10;short messages of each address are numbered from 0 with R = 1.&#10;Unchecked: N = 0 and R = 0 (a message in fragments takes a number apart from the other messages of the&#10;address in progress), numbered short messages are refused</string>
      </property>
      <property name="text">
       <string>Message numbers</string>
      </property>
     </widget>
    </item>
    <item row="12" column="2" colspan="2">
     <widget class="QSpinBox" name="flexMaxMessageNumber">
      <property name="toolTip">
       <string>Largest message number of the network (the pagers are set to it):&#10;after it the numbers of an address start from 0 again</string>
      </property>
      <property name="prefix">
       <string>Max N </string>
      </property>
      <property name="maximum">
       <number>63</number>
      </property>
      <property name="value">
       <number>63</number>
      </property>
     </widget>
    </item>
    <item row="13" column="0" colspan="2">
     <widget class="QToolButton" name="flexEventFlags">
      <property name="toolTip">
       <string>FLEX System Event Notification (STD-43A 3.8.2.4):&#10;the events announced to the pagers, to take place within the next 4 cycles</string>
      </property>
      <property name="text">
       <string>Events</string>
      </property>
      <property name="popupMode">
       <enum>QToolButton::InstantPopup</enum>
      </property>
     </widget>
    </item>
    <item row="13" column="2">
     <widget class="QSpinBox" name="flexEventFrames">
      <property name="toolTip">
       <string>Frames of the System Event Notification: it goes in every phase of each frame,&#10;for one cycle (128 frames) at least, up to the 4 cycles of the notice (512)</string>
      </property>
      <property name="suffix">
       <string> fr</string>
      </property>
      <property name="minimum">
       <number>128</number>
      </property>
      <property name="maximum">
       <number>512</number>
      </property>
      <property name="value">
       <number>128</number>
      </property>
     </widget>
    </item>
    <item row="13" column="3">
     <widget class="QPushButton" name="flexEventSend">
      <property name="toolTip">
       <string>Start the System Event Notification of the events checked (FLEX network mode);&#10;while it is sent, the frames left, and a click stops it</string>
      </property>
      <property name="text">
       <string>Notify</string>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QWidget" name="messageContainer" native="true">
   <property name="geometry">
    <rect>
     <x>2</x>
     <y>160</y>
     <width>376</width>
     <height>160</height>
    </rect>
   </property>
   <property name="windowTitle">
    <string>Message</string>
   </property>
   <layout class="QVBoxLayout" name="messageLayout">
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
    <property name="spacing">
     <number>0</number>
    </property>
    <item>
     <widget class="PagingComposer" name="composer" native="true"/>
    </item>
   </layout>
  </widget>
  <widget class="QWidget" name="queueContainer" native="true">
   <property name="geometry">
    <rect>
     <x>2</x>
     <y>324</y>
     <width>376</width>
     <height>200</height>
    </rect>
   </property>
   <property name="sizePolicy">
    <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
     <horstretch>0</horstretch>
     <verstretch>0</verstretch>
    </sizepolicy>
   </property>
   <property name="windowTitle">
    <string>Queue</string>
   </property>
   <layout class="QVBoxLayout" name="queueLayout">
    <property name="spacing">
     <number>3</number>
    </property>
    <property name="leftMargin">
     <number>2</number>
    </property>
    <property name="topMargin">
     <number>2</number>
    </property>
    <property name="rightMargin">
     <number>2</number>
    </property>
    <property name="bottomMargin">
     <number>2</number>
    </property>
    <item>
     <layout class="QHBoxLayout" name="queueStatusLayout">
      <item>
       <widget class="QLabel" name="status">
        <property name="toolTip">
         <string>The state of the transmitter and of its queue</string>
        </property>
        <property name="text">
         <string>Idle</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="queueSpacer">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>10</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QSpinBox" name="maxQueued">
        <property name="toolTip">
         <string>Queue size: messages not sent yet before new ones are refused. Lowered below the messages queued: they stay, new ones are refused until the queue is down</string>
        </property>
        <property name="prefix">
         <string>Max </string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>100000</number>
        </property>
        <property name="value">
         <number>10000</number>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QToolButton" name="openMessageCenter">
        <property name="toolTip">
         <string>Open the Message Center: the log of the messages of all the paging channels, its routes, sinks and sources, and the pages to transmit (it is added if there is none)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="clear">
        <property name="toolTip">
         <string>Drop the messages waiting</string>
        </property>
        <property name="text">
         <string>Clear</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="abort">
        <property name="toolTip">
         <string>Drop the messages waiting; one-shot: end the transmission being sent</string>
        </property>
        <property name="text">
         <string>Abort</string>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QTableView" name="messages">
      <property name="editTriggers">
       <set>QAbstractItemView::NoEditTriggers</set>
      </property>
      <property name="selectionBehavior">
       <enum>QAbstractItemView::SelectRows</enum>
      </property>
      <property name="selectionMode">
       <enum>QAbstractItemView::SingleSelection</enum>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QPlainTextEdit" name="log">
      <property name="toolTip">
       <string>Messages queued and the results of the requests</string>
      </property>
      <property name="readOnly">
       <bool>true</bool>
      </property>
      <property name="maximumBlockCount">
       <number>1000</number>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
