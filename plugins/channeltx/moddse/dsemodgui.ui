      <widget class="QWidget" name="angel61TunnelTab">
       <attribute name="icon">
        <iconset resource="../../../sdrgui/resources/res.qrc">
         <normaloff>:/link.png</normaloff>:/link.png</iconset>
       </attribute>
       <attribute name="title">
        <string/>
       </attribute>
       <attribute name="toolTip">
        <string>IP tunnel</string>
       </attribute>
       <layout class="QGridLayout" name="angel61TunnelTabLayout">
        <property name="leftMargin">
         <number>3</number>
        </property>
        <property name="topMargin">
         <number>3</number>
        </property>
        <property name="rightMargin">
         <number>3</number>
        </property>
        <property name="bottomMargin">
         <number>3</number>
        </property>
        <property name="spacing">
         <number>3</number>
        </property>
        <item row="0" column="0">
         <widget class="QCheckBox" name="angel61Tunnel">
          <property name="toolTip">
           <string>Carry IP datagrams for the peer station (ANGEL61.md 3.5). The link carries 333 bytes/s at the low rate and 900 at the high one: an interactive session, not a network connection. Needs administrator or root to create the interface.</string>
          </property>
          <property name="text">
           <string>Tunnel</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="angel61TunnelPeer">
          <property name="toolTip">
           <string>The callsign at the other end. Datagrams are only sent to this station and only accepted from it.</string>
          </property>
          <property name="maxLength">
           <number>20</number>
          </property>
          <property name="placeholderText">
           <string>Peer</string>
          </property>
         </widget>
        </item>
        <item row="0" column="2">
         <widget class="QLineEdit" name="angel61TunnelAddress">
          <property name="toolTip">
           <string>This end's address on the tunnel, with its prefix length: 10.255.0.1/32</string>
          </property>
          <property name="placeholderText">
           <string>10.255.0.1/32</string>
          </property>
         </widget>
        </item>
        <item row="0" column="3">
         <widget class="QSpinBox" name="angel61TunnelMTU">
          <property name="toolTip">
           <string>The largest datagram carried. 576 suits the low rate (29 fragments, 1.7 s); IPv6 needs 1280, which is 65 fragments and half of them lost at 1% block error rate.</string>
          </property>
          <property name="minimum">
           <number>68</number>
          </property>
          <property name="maximum">
           <number>1500</number>
          </property>
          <property name="singleStep">
           <number>4</number>
          </property>
          <property name="value">
           <number>576</number>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="angel61TunnelRoutesLabel">
          <property name="text">
           <string>Routes</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1" colspan="2">
         <widget class="QLineEdit" name="angel61TunnelRoutes">
          <property name="toolTip">
           <string>The prefixes routed into the tunnel and advertised to the peer, comma separated: 192.168.20.0/24, 2001:db8::/64. Nothing outside them is sent.</string>
          </property>
          <property name="placeholderText">
           <string>192.168.20.0/24</string>
          </property>
         </widget>
        </item>
        <item row="1" column="3">
         <widget class="QLineEdit" name="angel61TunnelInterface">
          <property name="toolTip">
           <string>The name of the host interface to create</string>
          </property>
          <property name="placeholderText">
           <string>sdrangel0</string>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="angel61TunnelAllowLabel">
          <property name="text">
           <string>Allow</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1" colspan="2">
         <widget class="QLineEdit" name="angel61TunnelAllow">
          <property name="toolTip">
           <string>What may be sent, comma separated: a protocol (icmp, tcp, udp, gre, esp, ah, sctp or a number) with a port or a port range for TCP, UDP and SCTP, which either port of a datagram may be in - icmp, tcp:22, udp:53. Empty: everything. What it refuses is counted below.</string>
          </property>
          <property name="placeholderText">
           <string>everything (icmp, tcp:22, ...)</string>
          </property>
         </widget>
        </item>
        <item row="2" column="3">
         <widget class="QLineEdit" name="angel61TunnelGroups">
          <property name="toolTip">
           <string>Multicast groups sent all the same, comma separated (224.0.0.251, ff02::fb); every other multicast and broadcast destination is refused</string>
          </property>
          <property name="placeholderText">
           <string>no multicast</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0" colspan="4">
         <widget class="QLabel" name="angel61TunnelStatus">
          <property name="toolTip">
           <string>The tunnel: datagrams sent and received, and those the filter would not carry (broadcast, multicast, or outside what the peer routes)</string>
          </property>
          <property name="text">
           <string>Tunnel: off</string>
          </property>
         </widget>
        </item>
        <item row="4" column="0" colspan="4">
         <widget class="QLabel" name="angel61TunnelTraffic">
          <property name="toolTip">
           <string>IP payload bytes accepted from the host for transmission and from the radio for delivery to the host. The totals reset when Tunnel is enabled.</string>
          </property>
          <property name="text">
           <string>IP traffic: TX 0 B   RX 0 B</string>
          </property>
         </widget>
        </item>
        <item row="5" column="0" colspan="4">
         <spacer name="angel61TunnelSpacer">
          <property name="orientation">
           <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>0</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
