          </property>
          <item>
           <property name="text">
            <string>Any</string>
           </property>
          </item>
         </widget>
        </item>
        <item row="4" column="0" colspan="4">
         <widget class="QLabel" name="angel61Link">
          <property name="toolTip">
           <string>What a DSD Demodulator in this instance heard from the destination: its rate request (1 asks for the high rate) and the request this station will send it</string>
